# ==============================================================
# Frontend Environment Variables
# ==============================================================
# Copy this file to .env and fill in the values.
# For local Docker development the docker-compose.yml provides
# these values automatically — you only need this file when
# deploying to Railway or running outside of Docker.
# ==============================================================

# Base URL for the backend API
# For local development: http://localhost:8000/api
# For Railway production: https://your-backend.up.railway.app/api
VITE_API_BASE_URL=https://your-backend.up.railway.app/api
