# ==============================================================
# Backend Environment Variables
# ==============================================================
# Copy this file to .env and fill in the values.
# For local Docker development the docker-compose.yml provides
# these values automatically — you only need this file when
# deploying to Railway or running outside of Docker.
# ==============================================================

# Django secret key – generate a unique value for production
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-real-secret-key

# Set to True only for local development
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames
# Railway provides a *.up.railway.app domain automatically
DJANGO_ALLOWED_HOSTS=.up.railway.app

# PostgreSQL connection string
# Railway provides two URLs when you add a Postgres plugin:
#   DATABASE_URL          – private network (preferred inside Railway)
#   DATABASE_PUBLIC_URL   – public proxy   (use if the private URL is unreachable)
# The backend will try DATABASE_URL first, then fall back to DATABASE_PUBLIC_URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/financial_accounting
# DATABASE_PUBLIC_URL=

# Comma-separated list of allowed CORS origins (your frontend URL)
CORS_ALLOWED_ORIGINS=https://your-frontend.up.railway.app
